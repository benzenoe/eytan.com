    function copyLink(button) {
        const url = window.location.href;

        // Copy to clipboard
        navigator.clipboard.writeText(url).then(() => {
            // Change icon to checkmark
            const icon = button.querySelector('i');
            const originalClass = icon.className;
            icon.className = 'fas fa-check';

            // Change button title
            const originalTitle = button.title;
            button.title = 'Copied!';

            // Add visual feedback class
            button.classList.add('copied');

            // Reset after 2 seconds
            setTimeout(() => {
                icon.className = originalClass;
                button.title = originalTitle;
                button.classList.remove('copied');
            }, 2000);
        }).catch(err => {
            console.error('Failed to copy link:', err);
            alert('Failed to copy link. Please try again.');
        });
    }

    // Extract and display hashtags from database or blog content
    function extractAndDisplayHashtags() {
        const hashtagsDisplay = document.getElementById('hashtags-display');
        const hashtagsSection = document.getElementById('hashtags-section');

        // First, check if hashtags exist in the database (pre-populated in the template)
        let hashtagsText = hashtagsDisplay.textContent.trim();

        // If no database hashtags, try to extract from blog content
        if (!hashtagsText) {
            const content = document.querySelector('.blog-post-body');
            if (content) {
                const text = content.textContent;
                // Match hashtags (# followed by letters/numbers, no spaces)
                const hashtagRegex = /#[A-Za-z0-9_]+/g;
                const hashtags = text.match(hashtagRegex);
                if (hashtags && hashtags.length > 0) {
                    hashtagsText = [...new Set(hashtags)].join(' ');
                }
            }
        }

        // If we have hashtags (from database or content), display them
        if (hashtagsText) {
            // Parse hashtags from text
            const hashtagRegex = /#[A-Za-z0-9_]+/g;
            const hashtags = hashtagsText.match(hashtagRegex);

            if (hashtags && hashtags.length > 0) {
                // Remove duplicates
                const uniqueHashtags = [...new Set(hashtags)];

                // Display hashtags as clickable Facebook links
                hashtagsDisplay.innerHTML = uniqueHashtags.map(tag => {
                    // Remove # and convert to lowercase for URL
                    const hashtagText = tag.substring(1).toLowerCase();
                    const facebookUrl = `https://www.facebook.com/hashtag/${hashtagText}`;
                    return `<a href="${facebookUrl}" target="_blank" rel="noopener noreferrer" style="color: #667eea; text-decoration: none; margin-right: 0.5rem; transition: color 0.2s;" onmouseover="this.style.color='#1877f2'" onmouseout="this.style.color='#667eea'">${tag}</a>`;
                }).join(' ');

                // Show the hashtags section
                hashtagsSection.style.display = 'block';

                // Store hashtags as plain text for copy function (no links)
                window.postHashtags = uniqueHashtags.join(' ');
            }
        }
    }

    // Copy hashtags to clipboard
    function copyHashtags() {
        if (!window.postHashtags) return;

        navigator.clipboard.writeText(window.postHashtags).then(() => {
            const button = document.querySelector('.copy-hashtags-btn');
            const icon = button.querySelector('i');
            const originalHTML = button.innerHTML;

            // Change to checkmark
            button.innerHTML = '<i class="fas fa-check"></i> Copied!';
            button.style.background = '#10b981';

            // Reset after 2 seconds
            setTimeout(() => {
                button.innerHTML = originalHTML;
                button.style.background = '#667eea';
            }, 2000);
        }).catch(err => {
            console.error('Failed to copy hashtags:', err);
            alert('Failed to copy hashtags. Please try again.');
        });
    }

